# AI補助（任意）。未設定ならルール抽出のみで動作します
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Tesseractの言語データの場所（通常は自動検出）
TESSDATA_PREFIX=
# Supabaseへの取り込み（STEP 8）。service_role キーは取り込み専用で、ブラウザやGitには絶対に入れない
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 音声教材（STEP 9）。voicevox＝ローカル無料 / google＝クラウド有料 / dummy＝テスト用
TTS_ENGINE=voicevox
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3
# Google Cloud Text-to-Speech を使う場合のみ。キーはGitに入れない
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=ja-JP-Neural2-B
